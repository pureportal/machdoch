# Install as /etc/systemd/system/machdoch-fleet.service after following
# docs/fleet-background-service.md. Run the agent as an unprivileged account.
[Unit]
Description=Machdoch headless Fleet host
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=machdoch
Group=machdoch
StateDirectory=machdoch
StateDirectoryMode=0700
WorkingDirectory=/var/lib/machdoch/workspace
Environment=HOME=/var/lib/machdoch MACHDOCH_USER_CONFIG_DIR=/var/lib/machdoch/config PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-/var/lib/machdoch/config/fleet-service.env
ExecStart=/opt/machdoch/machdoch fleet service run --cwd /var/lib/machdoch/workspace --json
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=78
TimeoutStopSec=35
KillMode=mixed
SendSIGKILL=yes
UMask=0077
NoNewPrivileges=yes
StandardInput=null
StandardOutput=journal
StandardError=journal
SyslogIdentifier=machdoch-fleet

[Install]
WantedBy=multi-user.target
