{
  "name": "machdoch",
  "version": "0.42.0",
  "private": true,
  "description": "Local-first OS AI agent for CLI and desktop.",
  "type": "module",
  "bin": {
    "machdoch": "./dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:cli-bundle": "node scripts/build-cli-bundle.mjs",
    "build:ui": "vite build --config vite.ui.config.ts",
    "check": "oxlint",
    "format": "oxfmt",
    "generate:runtime-contract": "node scripts/generate-runtime-contract.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "version:patch": "node scripts/bump-version.mjs patch",
    "version:minor": "node scripts/bump-version.mjs minor",
    "version:major": "node scripts/bump-version.mjs major",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "pnpm typecheck:core && pnpm typecheck:ui && pnpm typecheck:test",
    "typecheck:core": "tsc --noEmit -p tsconfig.json",
    "typecheck:ui": "tsc -p tsconfig.ui.json --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.logic-test.json",
    "verify": "pnpm check && pnpm typecheck && pnpm test",
    "dev": "oxnode src/cli/main.ts",
    "dev:ui": "vite --config vite.ui.config.ts",
    "inspect": "oxnode src/cli/main.ts inspect",
    "preview:ui": "vite preview --config vite.ui.config.ts",
    "start": "node dist/cli/main.js",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "tauri:dev": "tauri dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@oxc-node/cli": "^0.1.0",
    "@oxc-node/core": "^0.1.0",
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "rolldown": "^1.2.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "@google/genai": "^2.8.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-store": "^2.4.3",
    "@xyflow/react": "^12.11.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "chromium-bidi": "^16.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-sha256": "^1.3.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.18.0",
    "openai": "^6.46.0",
    "playwright-core": "^1.61.0",
    "radix-ui": "^1.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "packageManager": "pnpm@11.6.0+sha512.9a36518224080c6fe5165afdcfe79bfa118c29be703f3f462b1e32efe1e98e47e8750b148e08286250aad4113cc7993ca413c4e2cd447752708c2ee5751bc95f"
}
