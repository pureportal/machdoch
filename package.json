{
  "name": "machdoch",
  "version": "7.0.5",
  "private": true,
  "description": "Local-first OS AI agent for CLI and desktop.",
  "type": "module",
  "scripts": {
    "build": "pnpm run build:client && pnpm run build:fleet-manager && pnpm run build:landing",
    "build:client": "pnpm --filter @machdoch/client build",
    "build:cli-bundle": "pnpm --filter @machdoch/client build:cli-bundle",
    "build:fleet-manager": "pnpm --filter @machdoch/fleet-manager build",
    "build:landing": "pnpm --filter @machdoch/landing build",
    "build:ui": "pnpm --filter @machdoch/client build:ui",
    "check": "pnpm run check:packages && pnpm run check:client && pnpm run check:fleet-manager && pnpm run check:landing",
    "check:client": "pnpm --filter @machdoch/client check",
    "check:fleet-manager": "pnpm --filter @machdoch/fleet-manager check",
    "check:landing": "pnpm --filter @machdoch/landing check",
    "check:packages": "pnpm --filter \"./packages/*\" check",
    "coverage": "pnpm --filter @machdoch/client coverage",
    "dev": "oxnode apps/client/src/cli/main.ts",
    "dev:fleet-manager": "pnpm --filter @machdoch/fleet-manager dev",
    "dev:landing": "pnpm --filter @machdoch/landing dev",
    "dev:ui": "pnpm --filter @machdoch/client dev:ui",
    "format": "oxfmt .",
    "generate:runtime-contract": "pnpm --filter @machdoch/client generate:runtime-contract",
    "inspect": "oxnode apps/client/src/cli/main.ts inspect",
    "lint": "pnpm --filter @machdoch/client lint && pnpm --filter @machdoch/fleet-manager lint && pnpm --filter @machdoch/landing lint",
    "lint:fix": "pnpm --filter @machdoch/client lint:fix && pnpm --filter @machdoch/fleet-manager lint:fix && pnpm --filter @machdoch/landing lint:fix",
    "preview:landing": "pnpm --filter @machdoch/landing preview",
    "preview:ui": "pnpm --filter @machdoch/client preview:ui",
    "start": "node apps/client/dist/cli/main.js",
    "start:all": "pnpm run \"/^start:(fleet-manager|landing|machdoch)$/\"",
    "start:fleet-manager": "pnpm --filter @machdoch/fleet-manager start",
    "start:landing": "pnpm run dev:landing",
    "start:machdoch": "pnpm run tauri:dev",
    "tauri": "pnpm --filter @machdoch/client tauri",
    "tauri:build": "pnpm --filter @machdoch/client tauri:build",
    "tauri:dev": "pnpm --filter @machdoch/client tauri:dev",
    "test": "pnpm --filter @machdoch/client test && pnpm --filter @machdoch/fleet-manager test",
    "test:watch": "pnpm --filter @machdoch/client test:watch",
    "typecheck": "pnpm run typecheck:packages && pnpm run typecheck:client && pnpm run typecheck:fleet-manager && pnpm run typecheck:landing",
    "typecheck:client": "pnpm --filter @machdoch/client typecheck",
    "typecheck:core": "pnpm --filter @machdoch/client typecheck:core",
    "typecheck:fleet-manager": "pnpm --filter @machdoch/fleet-manager typecheck",
    "typecheck:landing": "pnpm --filter @machdoch/landing typecheck",
    "typecheck:packages": "pnpm --filter \"./packages/*\" typecheck",
    "typecheck:test": "pnpm --filter @machdoch/client typecheck:test",
    "typecheck:ui": "pnpm --filter @machdoch/client typecheck:ui",
    "verify": "pnpm run check && pnpm run typecheck && pnpm run test && pnpm run build",
    "verify:fleet-ui": "node scripts/verify-fleet-ui.mjs",
    "verify:chat-ui": "node scripts/verify-chat-ui.mjs",
    "verify:media-ui": "node scripts/verify-media-ui.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "version:major": "node scripts/bump-version.mjs major",
    "version:minor": "node scripts/bump-version.mjs minor",
    "version:patch": "node scripts/bump-version.mjs patch"
  },
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11.0.0"
  },
  "devDependencies": {
    "@oxc-node/cli": "^0.1.0",
    "@oxc-node/core": "^0.1.0",
    "@types/node": "^25.9.3",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "puppeteer-core": "^25.9.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.6.0+sha512.9a36518224080c6fe5165afdcfe79bfa118c29be703f3f462b1e32efe1e98e47e8750b148e08286250aad4113cc7993ca413c4e2cd447752708c2ee5751bc95f"
}
