{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://machdoch.local/schemas/instruction-delivery.schema.json",
  "title": "Machdoch instruction delivery plan or receipt",
  "oneOf": [{ "$ref": "#/$defs/plan" }, { "$ref": "#/$defs/receipt" }],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provider": {
      "enum": [
        "openai",
        "anthropic",
        "google",
        "langdock",
        "codex-cli",
        "claude-cli",
        "copilot-cli"
      ]
    },
    "lifecycleSupport": {
      "enum": ["reattached", "session", "unknown", "unsupported"]
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "detail"],
      "properties": {
        "name": {
          "enum": [
            "content",
            "scope",
            "authority",
            "native-isolation",
            "initial",
            "continuation",
            "retry",
            "roles",
            "subagents",
            "budget",
            "conformance",
            "receipt"
          ]
        },
        "status": {
          "enum": ["satisfied", "compatible", "unsupported"]
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapterVersion",
        "providerId",
        "surface",
        "authority",
        "contentFidelity",
        "scopeFidelity",
        "acceptsArbitraryContent",
        "nativeDiscovery",
        "acceptsTemporaryInstructionFile",
        "conformance",
        "receiptDigestVerification",
        "lifecycle",
        "mechanism",
        "evidence"
      ],
      "properties": {
        "adapterVersion": { "type": "string", "minLength": 1 },
        "providerId": { "$ref": "#/$defs/provider" },
        "surface": { "enum": ["api", "cli"] },
        "authority": {
          "enum": ["system", "developer", "native", "user", "none"]
        },
        "contentFidelity": {
          "enum": ["exact", "rewritten", "partial", "none"]
        },
        "scopeFidelity": {
          "enum": ["native-structural", "declarative-envelope", "none"]
        },
        "acceptsArbitraryContent": { "type": "boolean" },
        "nativeDiscovery": {
          "enum": [
            "isolated",
            "suppressed",
            "accounted-extra",
            "uncontrolled",
            "unknown"
          ]
        },
        "acceptsTemporaryInstructionFile": { "type": "boolean" },
        "conformance": {
          "enum": ["protocol-tested", "provisional", "unknown"]
        },
        "receiptDigestVerification": { "type": "boolean" },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "initial",
            "continuation",
            "retry",
            "roles",
            "subagents"
          ],
          "properties": {
            "initial": { "$ref": "#/$defs/lifecycleSupport" },
            "continuation": { "$ref": "#/$defs/lifecycleSupport" },
            "retry": { "$ref": "#/$defs/lifecycleSupport" },
            "roles": { "$ref": "#/$defs/lifecycleSupport" },
            "subagents": { "$ref": "#/$defs/lifecycleSupport" }
          }
        },
        "mechanism": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "version": { "type": "string", "minLength": 1 },
        "versionEvidence": { "type": "string", "minLength": 1 },
        "maxInstructionBytes": { "type": "integer", "minimum": 1 },
        "maxInputTokens": { "type": "integer", "minimum": 1 }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "grade": { "const": "full" } },
            "required": ["grade"]
          },
          "then": {
            "properties": {
              "blockingReasons": { "type": "array", "maxItems": 0 }
            }
          }
        },
        {
          "if": {
            "properties": { "grade": { "const": "unsupported" } },
            "required": ["grade"]
          },
          "then": {
            "properties": {
              "blockingReasons": { "type": "array", "minItems": 1 }
            }
          }
        }
      ],
      "required": [
        "schemaVersion",
        "planId",
        "resolutionId",
        "canonicalDigest",
        "environmentDigest",
        "providerId",
        "surface",
        "grade",
        "route",
        "blockingReasons",
        "dimensions",
        "capability",
        "createdAt"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "planId": {
          "type": "string",
          "pattern": "^instruction-plan:[0-9a-f]{64}$"
        },
        "resolutionId": {
          "type": "string",
          "pattern": "^instruction-resolution:[0-9a-f]{64}$"
        },
        "canonicalDigest": { "$ref": "#/$defs/digest" },
        "environmentDigest": { "$ref": "#/$defs/digest" },
        "providerId": { "$ref": "#/$defs/provider" },
        "surface": { "enum": ["api", "cli"] },
        "grade": { "enum": ["full", "compatible", "unsupported"] },
        "route": { "type": "string", "minLength": 1 },
        "blockingReasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "dimensions": {
          "type": "array",
          "items": { "$ref": "#/$defs/dimension" },
          "minItems": 12,
          "maxItems": 12,
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": { "name": { "const": "content" } },
                "required": ["name"]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": { "name": { "const": "scope" } },
                "required": ["name"]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": { "name": { "const": "authority" } },
                "required": ["name"]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": { "name": { "const": "native-isolation" } },
                "required": ["name"]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": { "name": { "const": "initial" } },
                "required": ["name"]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": { "name": { "const": "continuation" } },
                "required": ["name"]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": { "name": { "const": "retry" } },
                "required": ["name"]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": { "name": { "const": "roles" } },
                "required": ["name"]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": { "name": { "const": "subagents" } },
                "required": ["name"]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": { "name": { "const": "budget" } },
                "required": ["name"]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": { "name": { "const": "conformance" } },
                "required": ["name"]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": { "name": { "const": "receipt" } },
                "required": ["name"]
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        },
        "capability": { "$ref": "#/$defs/capability" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "detail"],
      "properties": {
        "kind": {
          "enum": ["request-field", "argument", "environment", "temporary-file"]
        },
        "detail": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "delivered" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "error": false }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "indeterminate" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "error": { "type": "string", "minLength": 1 }
            },
            "required": ["error"]
          }
        }
      ],
      "required": [
        "schemaVersion",
        "receiptId",
        "planId",
        "resolutionId",
        "canonicalDigest",
        "providerId",
        "surface",
        "phase",
        "route",
        "deliveredAt",
        "status",
        "observedCanonicalDigest",
        "assembledRequestDigest",
        "deliveredBytes",
        "truncation",
        "evidence",
        "bodyStored"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "receiptId": { "type": "string", "format": "uuid" },
        "planId": {
          "type": "string",
          "pattern": "^instruction-plan:[0-9a-f]{64}$"
        },
        "resolutionId": {
          "type": "string",
          "pattern": "^instruction-resolution:[0-9a-f]{64}$"
        },
        "canonicalDigest": { "$ref": "#/$defs/digest" },
        "providerId": { "$ref": "#/$defs/provider" },
        "surface": { "enum": ["api", "cli"] },
        "phase": {
          "enum": ["initial", "continuation", "retry", "validator", "generator"]
        },
        "route": { "type": "string", "minLength": 1 },
        "deliveredAt": { "type": "string", "format": "date-time" },
        "status": {
          "enum": ["delivered", "indeterminate"]
        },
        "observedCanonicalDigest": { "$ref": "#/$defs/digest" },
        "assembledRequestDigest": { "$ref": "#/$defs/digest" },
        "deliveredBytes": {
          "type": "integer",
          "minimum": 0
        },
        "estimatedTokens": {
          "type": "integer",
          "minimum": 0
        },
        "truncation": { "const": "none" },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "error": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" },
          "minItems": 1
        },
        "bodyStored": { "const": false }
      }
    }
  }
}
