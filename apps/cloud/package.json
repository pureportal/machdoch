{
  "name": "@machdoch/cloud",
  "version": "37.3.2",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "verify:cloud:design": "node scripts/verify-cloud-design.mjs",
    "verify:cloud:design:remote": "node --import @oxc-node/core/register scripts/verify-cloud-remote-design.mjs",
    "test:cloud": "pnpm build:workers && vitest run src/server/cloud src/components/cloud --maxWorkers=1",
    "verify:cloud": "node scripts/verify-cloud.mjs && node scripts/verify-cloud-cycles.mjs && node scripts/verify-cloud-comments.mjs && node scripts/verify-cloud-projects.mjs && node scripts/verify-cloud-labels.mjs && pnpm verify:cloud:relations && pnpm verify:cloud:workflows && node scripts/verify-cloud-request-recovery.mjs && pnpm verify:cloud:magic-links && pnpm verify:cloud:email-transport && pnpm verify:cloud:sso && pnpm verify:cloud:sso-resilience && pnpm verify:cloud:sessions && pnpm verify:cloud:invitations && node --import @oxc-node/core/register scripts/verify-cloud-execution.mjs && node scripts/verify-cloud-execution-providers.mjs && node scripts/verify-cloud-task-inference.mjs && node scripts/verify-cloud-access.mjs && node scripts/verify-cloud-providers.mjs && node scripts/verify-cloud-chat.mjs && pnpm verify:cloud:artifacts && pnpm verify:cloud:mcp && pnpm verify:cloud:client && pnpm verify:cloud:schedules && pnpm verify:cloud:schedule-lifecycle",
    "build": "pnpm build:workers && pnpm build:cloud-workflows && pnpm --filter @machdoch/client build:fleet-media && next build",
    "build:cloud-workflows": "node scripts/build-cloud-workflows.mjs",
    "cloud:workflows": "node --import @oxc-node/core/register scripts/cloud-workflows.ts",
    "verify:cloud:schedules": "node --import @oxc-node/core/register scripts/verify-cloud-schedules.mjs",
    "build:model-worker": "node scripts/build-model-worker.mjs",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "dev": "pnpm build:workers && pnpm --filter @machdoch/client build:fleet-media && nodemon src/server.ts dev",
    "format": "oxfmt src next.config.ts postcss.config.mjs package.json tsconfig.json components.json",
    "lint": "oxlint src next.config.ts",
    "lint:fix": "oxlint --fix src next.config.ts",
    "start": "node --disable-warning=ExperimentalWarning --import @oxc-node/core/register src/server.ts serve",
    "test": "pnpm build:workers && vitest run --maxWorkers=1",
    "typecheck": "next typegen && tsc --noEmit --pretty false",
    "verify:cloud:chat-live": "node scripts/verify-cloud-chat-live.mjs",
    "verify:cloud:task-live": "node --import @oxc-node/core/register scripts/verify-cloud-task-live.mjs",
    "verify:cloud:repository": "node --import @oxc-node/core/register scripts/verify-cloud-repository.mjs",
    "verify:cloud:mcp": "node --import @oxc-node/core/register scripts/verify-cloud-mcp.mjs",
    "verify:cloud:artifacts": "node --import @oxc-node/core/register scripts/verify-cloud-artifacts.mjs",
    "verify:cloud:runner-recovery": "node --import @oxc-node/core/register scripts/verify-cloud-runner-recovery.mjs",
    "verify:cloud:runner": "node --import @oxc-node/core/register scripts/verify-cloud-runner.mjs",
    "verify:cloud:client": "node --import @oxc-node/core/register scripts/verify-cloud-client.mjs",
    "verify:cloud:desktop": "node --import @oxc-node/core/register scripts/verify-cloud-desktop.mjs",
    "verify:cloud:managed-settings": "node --import @oxc-node/core/register scripts/verify-cloud-managed-settings.mjs",
    "verify:cloud:projects": "node scripts/verify-cloud-projects.mjs",
    "verify:cloud:workflows": "node --import @oxc-node/core/register scripts/verify-cloud-workflows.mjs",
    "verify:cloud:relations": "node --import @oxc-node/core/register scripts/verify-cloud-relations.mjs",
    "verify:cloud:labels": "node scripts/verify-cloud-labels.mjs",
    "verify:cloud:request-recovery": "node scripts/verify-cloud-request-recovery.mjs",
    "verify:cloud:runner-live": "node --import @oxc-node/core/register scripts/verify-cloud-runner-live.mjs",
    "build:smtp-worker": "node scripts/build-smtp-worker.mjs",
    "build:workers": "pnpm build:model-worker && pnpm build:smtp-worker && pnpm build:oidc-worker && pnpm build:recurrence-worker",
    "verify:cloud:magic-links": "node --import @oxc-node/core/register scripts/verify-cloud-magic-links.mjs",
    "verify:cloud:email-transport": "node --import @oxc-node/core/register scripts/verify-cloud-email-transport.mjs",
    "build:oidc-worker": "node scripts/build-oidc-worker.mjs",
    "cloud:recover-signin": "node --disable-warning=ExperimentalWarning --import @oxc-node/core/register scripts/cloud-recover-signin.ts",
    "verify:cloud:sso": "node --import @oxc-node/core/register scripts/verify-cloud-sso.mjs",
    "verify:cloud:sso-resilience": "node --import @oxc-node/core/register scripts/verify-cloud-sso-resilience.mjs",
    "verify:cloud:sessions": "node scripts/verify-cloud-sessions.mjs",
    "verify:cloud:invitations": "node scripts/verify-cloud-invitations.mjs",
    "build:recurrence-worker": "node scripts/build-recurrence-worker.mjs",
    "verify:cloud:task-schedules": "node --import @oxc-node/core/register scripts/verify-cloud-task-schedules.mjs",
    "verify:cloud:schedule-lifecycle": "node --import @oxc-node/core/register scripts/verify-cloud-schedule-lifecycle.mjs",
    "verify:cloud:cutover": "node --import @oxc-node/core/register scripts/verify-cloud-cutover.mjs",
    "verify:cloud:migration": "node --import @oxc-node/core/register scripts/verify-cloud-migration.mjs"
  },
  "nodemonConfig": {
    "watch": [
      "src/server.ts",
      "src/server",
      "next.config.ts"
    ],
    "ext": "ts,sql",
    "delay": 200,
    "exec": "node --enable-source-maps --disable-warning=ExperimentalWarning --import @oxc-node/core/register",
    "signal": "SIGTERM"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@machdoch/analytics": "workspace:*",
    "@machdoch/client-ui": "workspace:*",
    "@machdoch/fleet-protocol": "workspace:*",
    "@machdoch/media-studio": "workspace:*",
    "@machdoch/model-runtime": "workspace:*",
    "@machdoch/product-ui": "workspace:*",
    "@machdoch/recurrence": "workspace:*",
    "@machdoch/speech": "workspace:*",
    "@machdoch/text-to-speech": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@oxc-node/cli": "^0.1.0",
    "@oxc-node/core": "^0.1.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.18.0",
    "next": "^16.3.3",
    "nodemailer": "10.2.1",
    "openid-client": "6.8.8",
    "pg": "^8.23.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@machdoch/cloud-client": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "axe-core": "^4.13.0",
    "nodemon": "^3.1.14",
    "oidc-provider": "9.13.0",
    "rolldown": "^1.2.0",
    "smtp-server": "3.21.1",
    "tailwindcss": "^4.3.3",
    "vitest": "^4.1.10"
  }
}
