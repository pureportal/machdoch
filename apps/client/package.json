{
  "name": "@machdoch/client",
  "version": "7.0.2",
  "private": true,
  "description": "Local-first OS AI agent for CLI and desktop.",
  "type": "module",
  "bin": {
    "machdoch": "./dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:cli-bundle": "node scripts/build-cli-bundle.mjs",
    "build:ui": "vite build --config vite.ui.config.ts",
    "check": "oxlint .",
    "format": "oxfmt",
    "generate:runtime-contract": "node scripts/generate-runtime-contract.mjs",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "pnpm typecheck:core && pnpm typecheck:ui && pnpm typecheck:test",
    "typecheck:core": "tsc --noEmit -p tsconfig.json",
    "typecheck:ui": "tsc -p tsconfig.ui.json --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.logic-test.json",
    "verify": "pnpm check && pnpm typecheck && pnpm test",
    "dev": "oxnode src/cli/main.ts",
    "dev:ui": "vite --config vite.ui.config.ts",
    "inspect": "oxnode src/cli/main.ts inspect",
    "preview:ui": "vite preview --config vite.ui.config.ts",
    "start": "node dist/cli/main.js",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "tauri:dev": "tauri dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/ws": "^8.18.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.12.1",
    "jsdom": "^26.1.0",
    "rolldown": "^1.2.0",
    "tailwindcss": "^4.3.1",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@machdoch/fleet-protocol": "workspace:*",
    "@machdoch/product-ui": "workspace:*",
    "@anthropic-ai/sdk": "^0.104.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.7",
    "@google/genai": "^2.8.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-store": "^2.4.3",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "chromium-bidi": "^16.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fast-sha256": "^1.3.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.18.0",
    "mermaid": "^11.16.1",
    "openai": "^6.46.0",
    "playwright-core": "^1.61.0",
    "radix-ui": "^1.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.21.3"
  }
}
