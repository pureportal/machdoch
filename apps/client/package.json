{
  "name": "@machdoch/client",
  "version": "46.5.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "description": "Local-first OS AI agent for CLI and desktop.",
  "type": "module",
  "bin": {
    "machdoch": "./dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:cli-bundle": "node scripts/build-cli-bundle.mjs",
    "build:headless": "pnpm build:cli-bundle && node scripts/build-headless-package.mjs",
    "build:ui": "vite build --config vite.ui.config.ts",
    "build:cloud-fixture": "node scripts/build-cloud-workspace-fixture.mjs",
    "build:cloud-agent": "node scripts/build-cloud-agent.mjs",
    "verify:cloud:sandbox": "node --import @oxc-node/core/register scripts/verify-cloud-sandbox.mjs",
    "verify:cloud:agent": "node --import @oxc-node/core/register scripts/verify-cloud-agent.mjs",
    "verify:cloud:source": "node --import @oxc-node/core/register scripts/verify-cloud-source.mjs",
    "verify:cloud:volume": "node --import @oxc-node/core/register scripts/verify-cloud-volume.mjs",
    "verify:cloud:volume-sandbox": "node --import @oxc-node/core/register scripts/verify-cloud-volume.mjs --sandbox",
    "check": "oxlint .",
    "format": "oxfmt",
    "generate:runtime-contract": "node scripts/generate-runtime-contract.mjs",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "pnpm typecheck:core && pnpm typecheck:ui && pnpm typecheck:test",
    "typecheck:core": "tsc --noEmit -p tsconfig.json",
    "typecheck:ui": "tsc -p tsconfig.ui.json --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.logic-test.json",
    "verify": "pnpm check && pnpm typecheck && pnpm test",
    "dev": "oxnode src/cli/main.ts",
    "dev:ui": "vite --config vite.ui.config.ts",
    "inspect": "oxnode src/cli/main.ts inspect",
    "preview:ui": "vite preview --config vite.ui.config.ts",
    "start": "node dist/cli/main.js",
    "tauri": "node scripts/run-tauri.mjs",
    "tauri:build": "node scripts/run-tauri.mjs build",
    "tauri:dev": "node scripts/run-tauri.mjs dev",
    "test": "node --test scripts/windows-native-toolchain.test.mjs scripts/windows-vulkan-toolchain.test.mjs scripts/browser-runtime-archive.test.mjs scripts/download-verified-asset.test.mjs scripts/windows-speech-runtime.test.mjs scripts/prepare-drama3.test.mjs scripts/audit-media-image-verification.test.mjs && vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "build:fleet-media": "vite build --config vite.fleet-media.config.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "axe-core": "^4.14.1",
    "jsdom": "^31.0.1",
    "rolldown": "^1.3.3",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@google/genai": "^3.6.1",
    "@machdoch/analytics": "workspace:*",
    "@machdoch/client-ui": "workspace:*",
    "@machdoch/cloud-client": "workspace:*",
    "@machdoch/fleet-protocol": "workspace:*",
    "@machdoch/media-studio": "workspace:*",
    "@machdoch/model-runtime": "workspace:*",
    "@machdoch/product-ui": "workspace:*",
    "@machdoch/recurrence": "workspace:*",
    "@machdoch/speech": "workspace:*",
    "@machdoch/text-to-speech": "workspace:*",
    "@microsoft/mxc-sdk": "1.1.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-store": "^2.5.1",
    "@tauri-apps/plugin-updater": "2.14.1",
    "@uiw/react-codemirror": "^4.25.12",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^13.0.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "chromium-bidi": "160.0.8174-0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fast-sha256": "^1.3.0",
    "highlight.js": "^11.12.0",
    "html-to-image": "^1.11.13",
    "import-meta-resolve": "4.2.0",
    "lucide-react": "^1.77.0",
    "mermaid": "^12.3.0",
    "openai": "^7.62.0",
    "playwright-core": "^1.65.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "semver": "^7.8.6",
    "stream-chain": "^4.4.2",
    "stream-json": "^3.9.0",
    "tailwind-merge": "^3.7.1",
    "tar": "^7.5.23",
    "ws": "^8.23.0"
  }
}
