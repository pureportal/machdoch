{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://machdoch.local/schemas/instruction-library.schema.json",
  "title": "Machdoch instruction library",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "profiles", "workspaces"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "profiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/profile" }
    },
    "workspaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/workspace" }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "global": { "const": true } },
            "required": ["global"]
          },
          "then": {
            "properties": {
              "enabled": { "const": true },
              "match": false
            }
          }
        }
      ],
      "required": [
        "id",
        "name",
        "body",
        "enabled",
        "global",
        "tags",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
        },
        "description": {
          "type": "string",
          "maxLength": 2000,
          "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 131072,
          "pattern": "^[^\\u0000]*$",
          "description": "The runtime additionally enforces a 131072-byte UTF-8 limit; JSON Schema maxLength counts Unicode code points."
        },
        "enabled": { "type": "boolean" },
        "global": { "type": "boolean" },
        "tags": { "$ref": "#/$defs/tags" },
        "match": { "$ref": "#/$defs/tagRule" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "tags": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "^[^,\\u0000-\\u001F\\u007F]+$"
      },
      "uniqueItems": true
    },
    "tagRule": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "tag"],
          "properties": {
            "op": { "const": "tag" },
            "tag": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[^,\\u0000-\\u001F\\u007F]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "rules"],
          "properties": {
            "op": { "enum": ["and", "or"] },
            "rules": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "items": { "$ref": "#/$defs/tagRule" }
            }
          }
        }
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "profiles"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(\\.|(?![A-Za-z]:)(?!\\.\\.?(?:/|$))[^/\\\\\\u0000]+(?:/(?!\\.\\.?(?:/|$))[^/\\\\\\u0000]+)*)$"
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/uuid" },
          "uniqueItems": true
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "root", "tags", "scopes"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "root": { "type": "string", "minLength": 1 },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
        },
        "tags": { "$ref": "#/$defs/tags" },
        "scopes": {
          "type": "array",
          "items": { "$ref": "#/$defs/scope" }
        }
      }
    }
  }
}
