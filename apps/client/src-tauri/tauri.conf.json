{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "machdoch",
  "version": "2.2.0",
  "identifier": "com.machdoch.desktop",
  "build": {
    "beforeDevCommand": {
      "cwd": "..",
      "script": "pnpm run build:cli-bundle && pnpm run dev:ui"
    },
    "beforeBuildCommand": {
      "cwd": "..",
      "script": "pnpm run build:cli-bundle && pnpm run build:ui"
    },
    "devUrl": "http://127.0.0.1:4173",
    "frontendDist": "../dist/ui-preview"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "capabilities": ["default"]
    },
    "windows": [
      {
        "label": "main",
        "title": "machdoch",
        "width": 1440,
        "height": 960,
        "minWidth": 960,
        "minHeight": 720,
        "center": true,
        "visible": true,
        "preventOverflow": {
          "width": 24,
          "height": 24
        },
        "resizable": true,
        "skipTaskbar": false,
        "decorations": false,
        "transparent": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "resources": {
      "python/media_diffusers_worker.py": "python/media_diffusers_worker.py",
      "python/media_diffusers_requirements.txt": "python/media_diffusers_requirements.txt",
      "../scripts/build_source_anchored_loop.py": "python/build_source_anchored_loop.py"
    },
    "targets": ["msi", "nsis", "deb", "rpm", "appimage"],
    "windows": {
      "wix": {
        "fragmentPaths": ["windows/file-manager-context-menu.wxs"],
        "componentRefs": ["MachdochFileManagerContextMenu"]
      },
      "nsis": {
        "installerHooks": "windows/nsis-hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "recommends": ["python3-nautilus"],
        "files": {
          "/usr/share/kio/servicemenus/machdoch-folder-context.desktop": "linux/machdoch-folder-context.desktop",
          "/usr/share/kio/servicemenus/machdoch-files-context.desktop": "linux/machdoch-files-context.desktop",
          "/usr/share/nautilus-python/extensions/machdoch.py": "linux/machdoch_nautilus.py"
        }
      },
      "rpm": {
        "recommends": ["nautilus-python"],
        "files": {
          "/usr/share/kio/servicemenus/machdoch-folder-context.desktop": "linux/machdoch-folder-context.desktop",
          "/usr/share/kio/servicemenus/machdoch-files-context.desktop": "linux/machdoch-files-context.desktop",
          "/usr/share/nautilus-python/extensions/machdoch.py": "linux/machdoch_nautilus.py"
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
