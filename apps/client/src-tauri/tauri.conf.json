{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "machdoch",
  "version": "7.0.3",
  "identifier": "com.machdoch.desktop",
  "build": {
    "beforeDevCommand": {
      "cwd": "..",
      "script": "pnpm run build:cli-bundle && pnpm run dev:ui"
    },
    "beforeBuildCommand": {
      "cwd": "..",
      "script": "pnpm run build:cli-bundle && pnpm run build:ui"
    },
    "devUrl": "http://127.0.0.1:4173",
    "frontendDist": "../dist/ui-preview"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "capabilities": [
        "default"
      ]
    },
    "windows": [
      {
        "label": "main",
        "title": "machdoch",
        "width": 1440,
        "height": 960,
        "minWidth": 960,
        "minHeight": 720,
        "center": true,
        "visible": true,
        "preventOverflow": {
          "width": 24,
          "height": 24
        },
        "resizable": true,
        "skipTaskbar": false,
        "decorations": false,
        "transparent": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "publisher": "machdoch",
    "homepage": "https://github.com/pureportal/machdoch",
    "category": "Productivity",
    "shortDescription": "Local-first OS AI agent for CLI and desktop.",
    "longDescription": "Machdoch is a local-first AI assistant for Windows and Linux that works with folders, runs tasks, and automates repeatable workflows from the desktop or CLI.",
    "resources": {
      "python/media_diffusers_worker.py": "python/media_diffusers_worker.py",
      "python/media_diffusers_requirements.txt": "python/media_diffusers_requirements.txt",
      "../scripts/build_source_anchored_loop.py": "python/build_source_anchored_loop.py"
    },
    "targets": [
      "msi",
      "nsis",
      "deb",
      "rpm",
      "appimage"
    ],
    "windows": {
      "wix": {
        "upgradeCode": "47638e6f-1542-5d67-bc57-e5ae45db5fd8",
        "fragmentPaths": [
          "windows/file-manager-context-menu.wxs"
        ],
        "componentRefs": [
          "MachdochFileManagerContextMenu"
        ]
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/nsis-hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libgbm1",
          "libpipewire-0.3-0"
        ],
        "recommends": [
          "python3-nautilus"
        ],
        "files": {
          "/usr/share/kio/servicemenus/machdoch-folder-context.desktop": "linux/machdoch-folder-context.desktop",
          "/usr/share/kio/servicemenus/machdoch-files-context.desktop": "linux/machdoch-files-context.desktop",
          "/usr/share/nautilus-python/extensions/machdoch.py": "linux/machdoch_nautilus.py"
        }
      },
      "rpm": {
        "depends": [
          "libgbm.so.1()(64bit)",
          "libpipewire-0.3.so.0()(64bit)"
        ],
        "recommends": [
          "nautilus-python"
        ],
        "files": {
          "/usr/share/kio/servicemenus/machdoch-folder-context.desktop": "linux/machdoch-folder-context.desktop",
          "/usr/share/kio/servicemenus/machdoch-files-context.desktop": "linux/machdoch-files-context.desktop",
          "/usr/share/nautilus-python/extensions/machdoch.py": "linux/machdoch_nautilus.py"
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
