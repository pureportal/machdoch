{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "machdoch",
  "version": "29.2.0",
  "identifier": "com.machdoch.desktop",
  "build": {
    "beforeDevCommand": {
      "cwd": "..",
      "script": "node scripts/prepare-whisper-model.mjs && node scripts/prepare-local-speech.mjs && pnpm run build:cli-bundle && pnpm run dev:ui"
    },
    "beforeBuildCommand": {
      "cwd": "..",
      "script": "node scripts/prepare-whisper-model.mjs && node scripts/prepare-local-speech.mjs && pnpm run build:cli-bundle && pnpm run build:ui && node ../../scripts/licensing/generate.mjs desktop"
    },
    "devUrl": "http://127.0.0.1:4173",
    "frontendDist": "../dist/ui-preview"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "capabilities": [
        "default",
        "updater"
      ]
    },
    "windows": [
      {
        "label": "main",
        "title": "machdoch",
        "width": 1440,
        "height": 960,
        "minWidth": 960,
        "minHeight": 720,
        "center": true,
        "visible": false,
        "preventOverflow": {
          "width": 24,
          "height": 24
        },
        "resizable": true,
        "skipTaskbar": true,
        "decorations": false,
        "transparent": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "publisher": "machdoch",
    "license": "Apache-2.0",
    "licenseFile": "../../../LICENSE",
    "homepage": "https://github.com/pureportal/machdoch",
    "category": "Productivity",
    "shortDescription": "Local-first OS AI agent for CLI and desktop.",
    "longDescription": "Machdoch is a local-first AI assistant for Windows and Linux that works with folders, runs tasks, and automates repeatable workflows from the desktop or CLI.",
    "resources": {
      "../dist/legal-desktop": "legal",
      "resources/whisper/ggml-base-q5_1.bin": "whisper/ggml-base-q5_1.bin",
      "resources/whisper/ggml-tiny-q5_1.bin": "whisper/ggml-tiny-q5_1.bin",
