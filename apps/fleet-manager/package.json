{
  "name": "@machdoch/fleet-manager",
  "version": "19.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @machdoch/client build:fleet-media && next build",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "dev": "pnpm --filter @machdoch/client build:fleet-media && nodemon src/server.ts dev",
    "format": "oxfmt src next.config.ts postcss.config.mjs package.json tsconfig.json components.json",
    "lint": "oxlint src next.config.ts",
    "lint:fix": "oxlint --fix src next.config.ts",
    "password": "node --disable-warning=ExperimentalWarning --import @oxc-node/core/register src/server.ts password",
    "seed": "node --disable-warning=ExperimentalWarning --import @oxc-node/core/register src/server.ts seed",
    "settings-key": "node --disable-warning=ExperimentalWarning --import @oxc-node/core/register src/server.ts settings-key",
    "start": "node --disable-warning=ExperimentalWarning --import @oxc-node/core/register src/server.ts serve",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit --pretty false"
  },
  "nodemonConfig": {
    "watch": [
      "src/server.ts",
      "src/server",
      "next.config.ts"
    ],
    "ext": "ts,sql",
    "delay": 200,
    "exec": "node --enable-source-maps --disable-warning=ExperimentalWarning --import @oxc-node/core/register",
    "signal": "SIGTERM"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@machdoch/fleet-protocol": "workspace:*",
    "@machdoch/product-ui": "workspace:*",
    "@oxc-node/cli": "^0.1.0",
    "@oxc-node/core": "^0.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.18.0",
    "next": "^16.3.3",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "nodemon": "^3.1.14",
    "tailwindcss": "^4.3.3",
    "vitest": "^4.1.10"
  }
}
